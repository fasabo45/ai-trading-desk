# Required for the analyst seat
ANTHROPIC_API_KEY=sk-ant-...

# Optional: a private Solana RPC (Helius, Triton, QuickNode). Public RPC rate-limits fast.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Optional: alerts to your phone
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Stocks mode: Alpaca PAPER keys only
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# Optional: model ids. They get renamed and retired; a value here wins over the
# defaults in config.py, so a key with newer ids needs no code change.
# ANALYST_MODEL=claude-opus-4-5
# REVIEW_MODEL=claude-sonnet-4-5
